# Upstream OFL source fonts — re-fetchable via scripts/download_sources.py
sources/

# Logs / scratch / caches / session state
build/*.log
scratch_*
.keepawake/
*.tmp
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Note: build/*.ttf (the built Ninter fonts) ARE tracked on purpose,
# so the repo is directly installable without a rebuild.

# User test artifacts (not source)
*.pptx

# Generated web packages, rebuild with scripts/build_web.py
dist/

# Variable fonts, attached to GitHub Releases. Rebuild with scripts/build_variable.py
build/variable/
